# TiDB
DB_HOST=localhost
DB_PORT=3060
DB_NAME=crud_usuarios
DB_USERNAME=root
DB_PASSWORD=1234
DB_SSL_MODE=VERIFY_IDENTITY

# Kafka — Aiven
KAFKA_SERVICE_URI=kafka.servidor.com:7000
# Passwords de los certificados .p12 descargados de la consola de Aiven
KAFKA_TRUSTSTORE_PASSWORD=tucontra
KAFKA_KEYSTORE_PASSWORD=tucontra
KAFKA_KEY_PASSWORD=tucontra
# Opcion 1: Base64 (Recomendado para Render / Cloud sin subir archivos)
KAFKA_TRUSTSTORE_BASE64=
KAFKA_KEYSTORE_BASE64=
# Opcion 2: Ruta en disco (dejar vacio en local para usar src/main/resources/)
KAFKA_TRUSTSTORE_LOCATION=
KAFKA_KEYSTORE_LOCATION=

# REST Request
ACCOUNT_SERVICE_URL=http://localhost:8080