# =============================================================================
# Archivo de ejemplo de Variables de Entorno (.env)
# Copia este archivo como .env y ajusta los valores correspondientes a tu entorno.
# =============================================================================

# ---------------------------------------------
# Configuración del Servidor Spring Boot
# ---------------------------------------------
PORT=8080

# ---------------------------------------------
# Base de Datos MySQL
# ---------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=crud_usuarios
DB_USERNAME=root
DB_PASSWORD=
DB_SSL_MODE=DISABLED

# ---------------------------------------------
# Seguridad JWT
# ---------------------------------------------
JWT_SECRET=ZGV2ZWxvcG1lbnQtb25seS1qd3Qtc2VjcmV0LW11c3QtYmUtcmVwbGFjZWQ=
JWT_EXPIRATION_SECONDS=900

# ---------------------------------------------
# Integración con Microservicio Externo: Account Microservice
# ---------------------------------------------
# URL base del microservicio de cuentas (ej. local http://localhost:8000 o URL de producción)
ACCOUNT_SERVICE_URL=http://localhost:8000
ACCOUNT_SERVICE_CONNECT_TIMEOUT_SECONDS=5
ACCOUNT_SERVICE_READ_TIMEOUT_SECONDS=10

# ---------------------------------------------
# Apache Kafka / Aiven
# ---------------------------------------------
KAFKA_SERVICE_URI=kafka-11a18fa7-tercer-corte-electiva.d.aivencloud.com:27108
KAFKA_TOPIC_USER_CREATED=user-created-topic
KAFKA_TOPIC_USER_UPDATED=user-updated-topic
KAFKA_TOPIC_USER_DELETED=user-deleted-topic
KAFKA_TRUSTSTORE_LOCATION=classpath:truststore.p12
KAFKA_TRUSTSTORE_PASSWORD=
KAFKA_KEYSTORE_LOCATION=classpath:keystore.p12
KAFKA_KEYSTORE_PASSWORD=
KAFKA_KEY_PASSWORD=
